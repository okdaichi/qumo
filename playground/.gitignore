# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Vite build output. Ignore its contents but keep the committed placeholder
# (index.html + .gitkeep) so `go:embed all:playground/dist` in the Go binary
# always has a match on a fresh clone. Ignoring the directory itself (just
# `dist`) would also exclude the placeholder, hence `dist/*` + negations.
dist/*
!dist/.gitkeep
!dist/index.html
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite temp files
vite.config.ts.timestamp-*

# Local environment (contains machine-specific cert hash)
.env
