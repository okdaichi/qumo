# Git
.git
.gitignore

# Build artifacts
bin/
*.exe
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.*
*.coverprofile

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies
vendor/

# Environment
.env
.env.local

# Certificates (will be generated or mounted as volume)
certs/

# Documentation
*.md
!README.md
docs/

# CI/CD
.github/

# Node modules
**/node_modules/
# Keep the playground frontend source out of the relay image context, but the
# committed dist placeholder must remain — `//go:embed all:playground/dist`
# (embed.go) needs it at `go build` time. (The real UI is embedded by `mage
# build`, which runs `mage webbuild` first; the image builds with the placeholder.)
playground/*
!playground/dist/

# Magefiles
magefiles/

# Nomad
*.nomad

# Examples and demos
examples/
benchmarks/

# Go workspace
go.work
go.work.sum
