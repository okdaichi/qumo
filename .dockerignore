docs/

# CI/CD
.github/

# Node modules
**/node_modules/
# The docker/Dockerfile frontend stage builds the playground UI from source, so
# the playground tree must be in context. Exclude only host build output and the
# local env (the real dist is built inside the image).
playground/dist
playground/.env

# Magefiles
magefiles/

# Nomad
*.nomad

# Examples and demos
examples/
benchmarks/

# Go workspace
go.work
go.work.sum
