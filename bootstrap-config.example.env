# qumo bootstrap — environment variable configuration example
#
# Usage:
#   export $(grep -v '^#' bootstrap.env | xargs)   # bash/zsh
#   qumo bootstrap
#
# For systemd deployments, use:
#   EnvironmentFile=/etc/qumo/bootstrap.env
#
# For Docker:
#   docker run --env-file bootstrap.env ghcr.io/okdaichi/qumo bootstrap

# ─── Server ──────────────────────────────────────────────────────────────────

# Address to listen on.
BOOTSTRAP_LISTEN=:8080

# ─── Node Registry ──────────────────────────────────────────────────────────

# How long a node registration stays valid before expiring.
BOOTSTRAP_TTL=30s

# Interval between cleanup sweeps of expired nodes.
BOOTSTRAP_CLEANUP_INTERVAL=5s

# Maximum number of peers returned per /peers request.
BOOTSTRAP_MAX_PEERS=20
