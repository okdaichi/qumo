# qumo relay — environment variable configuration example
#
# Usage:
#   export $(grep -v '^#' relay.env | xargs)   # bash/zsh
#   qumo relay
#
# For systemd deployments, use:
#   EnvironmentFile=/etc/qumo/relay.env
#
# For Docker:
#   docker run --env-file relay.env ghcr.io/qumo-dev/qumo relay

# ─── Server ──────────────────────────────────────────────────────────────────

# Address to bind the relay server (QUIC/MoQT).
RELAY_ADDR=0.0.0.0:4433

# TLS certificate and key.
# Set INSECURE=true to generate an ephemeral self-signed cert (dev/test only).
CERT_FILE=certs/server.crt
KEY_FILE=certs/server.key
# INSECURE=true

# ─── Node identity ───────────────────────────────────────────────────────────

# Human-readable node identifier (defaults to hostname).
RELAY_NAME=relay-tokyo

# Geographic region label (arbitrary string, e.g. "asia", "europe").
REGION=asia

# Node role: "hub" (inter-region) or "edge" (client-facing).
# Leave empty for a standalone relay.
ROLE=hub

# Public address advertised to peers and bootstrap servers.
# Required when RELAY_ADDR is a wildcard (0.0.0.0 / ::).
ADVERTISE_ADDR=relay-tokyo.example.com:4433

# ─── Capacity ────────────────────────────────────────────────────────────────

# Maximum number of group caches held in memory (default: 100).
# GROUP_CACHE_SIZE=100

# Frame buffer size in bytes (default: 1500, roughly one network MTU).
# FRAME_CAPACITY=1500

# ─── Static peers (optional) ─────────────────────────────────────────────────

# Comma-separated list of peer relay addresses.
# The node connects to each peer and relays their announcements.
# PEERS=moqt://relay-london.example.com:4433,moqt://relay-newyork.example.com:4433

# ─── Bootstrap-based discovery (optional) ────────────────────────────────────

# Comma-separated list of bootstrap server URLs.
# The node registers itself and fetches the peer list at BOOTSTRAP_INTERVAL.
# BOOTSTRAP_URLS=http://bootstrap-1.example.com:8080,http://bootstrap-2.example.com:8080

# Optional bearer token sent to bootstrap endpoints for authentication.
# BOOTSTRAP_AUTH_TOKEN=supersecret

# Poll interval for each bootstrap server (default: 15s).
# BOOTSTRAP_INTERVAL=15s
